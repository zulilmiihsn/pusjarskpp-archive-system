{
  "name": "portal-arsip",
  "version": "1.0.0",
  "description": "Dokumentasi dan implementasi aplikasi pengelolaan arsip persuratan PUSJARSKPP berbasis Google Apps Script, Google Drive, dan Google Sheets.",
  "main": "Code.gs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node tests/unit.test.js && node tests/integration.test.js && node scripts/verify-project.js",
    "lint": "npx eslint \"**/*.gs\"",
    "clasp:status": "clasp status",
    "clasp:push": "node scripts/generate-assets.js && clasp push",
    "deploy:staging": "node -e \"require('fs').copyFileSync('.clasp.staging.json', '.clasp.json')\" && npm run clasp:push",
    "deploy:prod": "node -e \"require('fs').copyFileSync('.clasp.prod.json', '.clasp.json')\" && npm run clasp:push",
    "postinstall": "node scripts/generate-assets.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "eslint": "^10.4.1"
  }
}
