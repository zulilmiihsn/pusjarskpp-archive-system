# Ignore all files by default
**

# Allow Google Apps Script source files
!*.gs
!*.html
!appsscript.json

# Explicitly ignore configurations, dependencies, documentation, and templates
node_modules/**
docs/**
templates/**
package.json
package-lock.json
README.md
.gitignore
.clasp.json
.claspignore
tests/**
scripts/**

# Junk/artefak build & debug — jangan ikut ke-push ke GAS
Concatenated.html
EvaluatedIndex.html
tmp_*.html
temp_*.html
._*
